---
interface Props {
    href?: string;
    variant?: "primary" | "secondary" | "gold" | "outline";
    class?: string;
    id?: string;
    [x: string]: any;
}

const {
    href,
    variant = "primary",
    class: className,
    id,
    ...rest
} = Astro.props;

const variants = {
    primary: "bg-light text-dark hover:bg-light-muted",
    secondary:
        "bg-dark-gray text-light border border-smoke hover:border-purple-light/30",
    gold: "bg-gradient-to-r from-purple via-purple-light to-purple-glow text-dark font-semibold hover:shadow-lg hover:shadow-purple-light/20 hover:scale-105 active:scale-95",
    outline:
        "bg-transparent text-purple-light border border-purple-light hover:bg-purple-light hover:text-dark",
};

const baseClass =
    "inline-block px-8 py-4 rounded-full transition-all duration-300 font-body text-center cursor-pointer";
const finalClass = `${baseClass} ${variants[variant as keyof typeof variants]} ${className || ""}`;
---

{
    href ? (
        <a href={href} class={finalClass} id={id} {...rest}>
            <slot />
        </a>
    ) : (
        <button class={finalClass} id={id} {...rest}>
            <slot />
        </button>
    )
}
