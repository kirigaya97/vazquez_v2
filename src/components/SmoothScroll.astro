<script>
    import "lenis/dist/lenis.css";

    let lenis: any = null;

    async function initLenis() {
        // Check for reduced motion preference
        const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        if (prefersReducedMotion) return;

        const { gsap, ScrollTrigger } = await import("../lib/gsap-init");

        // Skip Lenis on touch/mobile devices.
        // Observer-based sections handle their own touch input and Lenis
        // would intercept touch events before Observer can process them.
        if (ScrollTrigger.isTouch) return;

        if (lenis) {
            lenis.destroy();
        }

        const { default: Lenis } = await import("lenis");

        lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: "vertical",
            gestureOrientation: "vertical",
            smoothWheel: true,
            wheelMultiplier: 1,
            touchMultiplier: 2,
        });

        // Bridge Lenis scroll events → ScrollTrigger recalculation
        lenis.on("scroll", ScrollTrigger.update);

        // Piggyback on GSAP's existing ticker instead of a dedicated rAF loop
        gsap.ticker.add((time) => {
            lenis?.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);
    }

    // Initialize on page load and after every View Transition navigation
    document.addEventListener("astro:page-load", () => {
        initLenis();
    });
</script>
