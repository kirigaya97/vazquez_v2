---
import Button from "../ui/Button.astro";
import siteConfig from "../../data/site-config.json";

interface Props {
    t: {
        title: string;
        subtitle: string;
        cta: string;
        hoverPrompt: string;
        tapPrompt: string;
        tooltipDesktop: string;
        tooltipMobile: string;
        circleFontSize: {
            desktop: number;
            mobile: number;
        };
    };
}

const { t } = Astro.props;

// Image pools for presentation
const presentationImages = Array.from(
    { length: 51 },
    (_, i) =>
        `/images/hero-presentation-webp/hero-${(i + 1).toString().padStart(2, "0")}.webp`,
);

// Split images into 3 columns for desktop
const colSize = Math.ceil(presentationImages.length / 3);
const columns = [
    presentationImages.slice(0, colSize),
    presentationImages.slice(colSize, colSize * 2),
    presentationImages.slice(colSize * 2),
];
---

<section
    id="hero-section"
    class="relative h-screen flex items-center justify-center overflow-clip bg-dark"
>
    <!-- LAYER 0: NOISE BACKGROUND -->
    <div class="absolute inset-0 hero-noise-bg z-0 pointer-events-none"></div>

    <!-- LAYER 5: IMAGE PRESENTATION GRID -->
    <div
        id="hero-presentation"
        class="absolute inset-0 grid grid-cols-1 md:grid-cols-3 opacity-0 z-[5] pointer-events-none"
    >
        {
            columns.map((colImages, colIdx) => (
                <div
                    id={`hero-col-${colIdx}`}
                    class={`relative overflow-hidden ${colIdx > 0 ? "hidden md:block" : "col-span-1"}`}
                >
                    {colImages.map((src, imgIdx) => (
                        <img
                            src={src}
                            alt=""
                            class="absolute inset-0 w-full h-full object-cover opacity-0 scale-100"
                            data-img-idx={imgIdx}
                            loading="lazy"
                            decoding="async"
                            width="400"
                            height="800"
                        />
                    ))}
                </div>
            ))
        }
    </div>

    <!-- LAYER 8: DARK OVERLAY (for text readability over presentation) -->
    <div
        id="hero-presentation-overlay"
        class="absolute inset-0 bg-dark/60 opacity-0 z-[8] pointer-events-none"
    >
    </div>

    <!-- LAYER 10: FOREGROUND IMAGE -->
    <div
        id="hero-foreground"
        class="absolute inset-0 flex items-end justify-center md:justify-end md:translate-x-[5vw] z-10 pointer-events-none"
    >
        <img
            src="/images/hero_foreground.png"
            alt="Fernando Vazquez"
            class="h-[50vh] md:h-[60vh] w-auto max-w-none md:max-w-full object-contain object-bottom"
            fetchpriority="high"
            width="578"
            height="432"
        />
    </div>

    <!-- LAYER 20: HERO CONTENT -->
    <div
        id="hero-content"
        class="relative container mx-auto px-6 text-center z-20 pointer-events-none -translate-y-[25vh] md:translate-y-0"
    >
        <h1
            class="hero-title text-4xl md:text-6xl lg:text-8xl font-body font-black uppercase text-light leading-tight mb-6 drop-shadow-2xl"
        >
            {t.title}
        </h1>
        <p
            class="hero-subtitle text-xl md:text-2xl lg:text-3xl font-heading italic text-purple-light mb-6 md:mb-12 drop-shadow-lg"
        >
            {t.subtitle}
        </p>
        <div class="hero-cta" style="pointer-events: auto;">
            <Button variant="gold" href="#shows" id="hero-cta-btn">
                {t.cta}
            </Button>
        </div>
    </div>

    <!-- LAYER 30: MAGIC TRIGGER -->
    <div
        id="hero-magic-trigger"
        class="hero-trigger-glow absolute bottom-[calc(2.5rem+3vh)] left-6 w-[140px] h-[140px] md:bottom-16 md:left-10 md:w-[200px] md:h-[200px] flex items-center justify-center cursor-pointer select-none z-[30]"
        role="button"
        tabindex="0"
        aria-label={t.hoverPrompt}
        data-cursor="magic"
    >
        <!-- 3D Spinning Star -->
        <div
            class="hero-symbol-3d absolute inset-0 flex items-center justify-center"
        >
            <svg
                viewBox="0 0 80 80"
                class="w-14 h-14 md:w-20 md:h-20 drop-shadow-[0_0_20px_rgba(149,130,217,0.4)]"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M40 4L47.6 28.4H73.2L52.8 43.6L60.4 68L40 52.8L19.6 68L27.2 43.6L6.8 28.4H32.4L40 4Z"
                    fill="#9582D9"
                    stroke="#7B68C8"
                    stroke-width="1"></path>
            </svg>
        </div>

        <!-- Orbiting Text -->
        <svg
            class="hero-orbit-text absolute inset-0 w-full h-full hidden md:block"
            viewBox="0 0 200 200"
        >
            <defs
                ><path
                    id="orbitDesktop"
                    d="M100,100 m-75,0 a75,75 0 1,1 150,0 a75,75 0 1,1 -150,0"
                ></path></defs
            >
            <text
                fill="#9582D9"
                font-size={t.circleFontSize.desktop}
                font-weight="900"
                font-family="Inter, sans-serif"
                letter-spacing="2"
            >
                <textPath href="#orbitDesktop" startOffset="0%"
                    >{t.hoverPrompt} · {t.hoverPrompt} ·</textPath
                >
            </text>
        </svg>

        <svg
            class="hero-orbit-text absolute inset-0 w-full h-full md:hidden"
            viewBox="0 0 140 140"
        >
            <defs
                ><path
                    id="orbitMobile"
                    d="M70,70 m-50,0 a50,50 0 1,1 100,0 a50,50 0 1,1 -100,0"
                ></path></defs
            >
            <text
                fill="#9582D9"
                font-size={t.circleFontSize.mobile}
                font-weight="900"
                font-family="Inter, sans-serif"
                letter-spacing="1"
            >
                <textPath href="#orbitMobile" startOffset="0%"
                    >{t.tapPrompt} · {t.tapPrompt} ·</textPath
                >
            </text>
        </svg>

        <!-- Tooltip -->
        <div
            id="hero-trigger-tooltip"
            class="absolute opacity-0 pointer-events-none select-none transition-opacity duration-500"
        >
            <div
                class="hidden md:flex items-center gap-3 absolute left-[calc(100%+6vw)] top-1/2 -translate-y-1/2"
            >
                <div class="w-8 h-px bg-purple-light/50"></div>
                <span
                    class="text-base font-body font-bold text-purple-light whitespace-nowrap tracking-wide"
                    >{t.tooltipDesktop}</span
                >
            </div>
            <div
                class="flex md:hidden flex-col items-center gap-2 absolute bottom-[calc(100%+9vh)] left-1/2 -translate-x-1/2"
            >
                <span
                    class="text-sm font-body font-bold text-purple-light whitespace-nowrap tracking-wide"
                    >{t.tooltipMobile}</span
                >
                <div class="w-px h-8 bg-purple-light/50"></div>
            </div>
        </div>
    </div>

    <!-- SCROLL INDICATOR -->
    <div
        id="hero-scroll-indicator"
        class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce z-20 pointer-events-none"
    >
        <svg
            class="w-6 h-6 text-purple-light/50"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
    </div>
</section>

<script>
    import { gsap } from "../../lib/gsap-init";

    let heroCleanup: (() => void) | null = null;

    function initHero() {
        if (heroCleanup) {
            heroCleanup();
            heroCleanup = null;
        }

        const trigger = document.getElementById("hero-magic-trigger");
        const presentation = document.getElementById("hero-presentation");
        const presOverlay = document.getElementById(
            "hero-presentation-overlay",
        );
        const foreground = document.getElementById("hero-foreground");
        const tooltip = document.getElementById("hero-trigger-tooltip");

        if (!trigger || !presentation || !foreground || !presOverlay) return;

        // 1. Audio Setup
        const audio = new Audio("/mp3/hero-track.mp3");
        audio.loop = true;

        // Set initial hidden state via GSAP (not Tailwind classes)
        gsap.set(".hero-title", { opacity: 0, y: 20, filter: "blur(20px)" });
        gsap.set(".hero-subtitle", { opacity: 0, y: 10, filter: "blur(15px)" });
        gsap.set(".hero-cta", { opacity: 0, y: 10, scale: 0.9 });

        // 2. Entrance Animation
        const tl = gsap.timeline();
        tl.to(".hero-title", {
            opacity: 1,
            filter: "blur(0px)",
            y: 0,
            duration: 2,
            ease: "power2.out",
        })
            .to(
                ".hero-subtitle",
                {
                    opacity: 1,
                    filter: "blur(0px)",
                    y: 0,
                    duration: 1.5,
                    ease: "power2.out",
                },
                "-=1.5",
            )
            .to(
                ".hero-cta",
                {
                    opacity: 1,
                    scale: 1,
                    y: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                },
                "-=0.8",
            );

        const columns = [
            document.getElementById("hero-col-0"),
            document.getElementById("hero-col-1"),
            document.getElementById("hero-col-2"),
        ].filter(Boolean) as HTMLElement[];

        const columnTimers: gsap.core.Tween[] = [];
        let immersive = false;

        const startPresentation = () => {
            if (immersive) return;
            immersive = true;

            // Fade out foreground, fade in presentation
            gsap.to(foreground, { opacity: 0, duration: 0.5, overwrite: true });
            gsap.to(presentation, {
                opacity: 1,
                duration: 0.5,
                overwrite: true,
            });
            gsap.to(presOverlay, {
                opacity: 1,
                duration: 0.5,
                overwrite: true,
            });

            // User requested animations:
            // 1. Subtitle and CTA go transparent
            // 2. Title increases size by 15% (scale 1.15)
            // 3. Title moves downward to be centered
            gsap.to(".hero-subtitle, .hero-cta", {
                opacity: 0,
                pointerEvents: "none",
                duration: 0.6,
                ease: "power2.inOut",
                overwrite: true,
            });

            gsap.to(".hero-title", {
                scale: 1.15,
                y:
                    window.innerWidth < 768
                        ? window.innerHeight * 0.2
                        : window.innerHeight * 0.1, // Move down to center visually
                duration: 1.2,
                ease: "power2.inOut",
                overwrite: true,
            });

            // Start audio
            audio.play().catch((e) => console.log("Audio play blocked:", e));

            columns.forEach((col, colIdx) => {
                const imgs = Array.from(col.querySelectorAll("img"));
                if (imgs.length === 0) return;

                let currentIdx = Math.floor(Math.random() * imgs.length);

                // Show initial random image
                gsap.set(imgs[currentIdx], { opacity: 1, scale: 1.05 });

                const cycleImage = () => {
                    const prevIdx = currentIdx;
                    currentIdx = (currentIdx + 1) % imgs.length;

                    // Kill any stale tweens and hide all images except the outgoing one
                    imgs.forEach((img, i) => {
                        if (i !== prevIdx && i !== currentIdx) {
                            gsap.killTweensOf(img);
                            gsap.set(img, { opacity: 0 });
                        }
                    });

                    // Crossfade
                    gsap.to(imgs[prevIdx], {
                        opacity: 0,
                        scale: 1.15,
                        duration: 0.4,
                        overwrite: true,
                    });

                    // Use set + to instead of fromTo to avoid the single-frame flash
                    gsap.set(imgs[currentIdx], { scale: 1.0 });
                    gsap.to(imgs[currentIdx], {
                        opacity: 1,
                        scale: 1.05,
                        duration: 0.4,
                        overwrite: true,
                    });

                    const delay = window.innerWidth < 768 ? 1.0 : 1.2;
                    columnTimers[colIdx] = gsap.delayedCall(delay, cycleImage);
                };

                const initialDelay = window.innerWidth < 768 ? 1.0 : 1.2;
                columnTimers[colIdx] = gsap.delayedCall(
                    initialDelay,
                    cycleImage,
                );
            });
        };

        const stopPresentation = () => {
            if (!immersive) return;
            immersive = false;

            columnTimers.forEach((call) => call.kill());
            columnTimers.length = 0;

            gsap.to(audio, {
                volume: 0,
                duration: 0.4,
                overwrite: true,
                onComplete: () => {
                    audio.pause();
                    audio.currentTime = 0;
                    audio.volume = 1; // Reset for next play
                },
            });

            gsap.to(foreground, { opacity: 1, duration: 0.5, overwrite: true });
            gsap.to(presentation, {
                opacity: 0,
                duration: 0.5,
                overwrite: true,
            });
            gsap.to(presOverlay, {
                opacity: 0,
                duration: 0.5,
                overwrite: true,
            });

            // Reset text animations
            gsap.to(".hero-subtitle, .hero-cta", {
                opacity: 1,
                pointerEvents: "auto",
                duration: 0.5,
                ease: "power2.out",
                overwrite: true,
            });

            gsap.to(".hero-title", {
                scale: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                overwrite: true,
            });

            // Reset all images
            columns.forEach((col) => {
                const imgs = col.querySelectorAll("img");
                imgs.forEach((img) =>
                    gsap.set(img, { opacity: 0, scale: 1.0 }),
                );
            });
        };

        // 4. Interaction Listeners
        const handleTriggerTouch = (e: TouchEvent) => {
            e.preventDefault();
            e.stopPropagation(); // Avoid triggering window stop immediately
            immersive ? stopPresentation() : startPresentation();
        };

        const handleGlobalTouch = () => {
            if (immersive) stopPresentation();
        };

        trigger.addEventListener("mouseenter", startPresentation);
        trigger.addEventListener("mouseleave", stopPresentation);
        trigger.addEventListener("touchstart", handleTriggerTouch, {
            passive: false,
        });
        window.addEventListener("touchstart", handleGlobalTouch, {
            passive: true,
        });

        // 5. Exit Observer: Stop when section leaves viewport
        const heroSection = document.getElementById("hero-section");
        const exitIO = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting && immersive) {
                        stopPresentation();
                    }
                });
            },
            { threshold: 0 },
        );
        if (heroSection) exitIO.observe(heroSection);

        // Attention System (Tooltips/Nudges)
        let hasInteracted = false;
        function stopAttention() {
            hasInteracted = true;
            if (tooltip) tooltip.style.opacity = "0";
        }

        trigger.addEventListener("mouseenter", stopAttention, { once: true });
        trigger.addEventListener("touchstart", stopAttention, { once: true });

        setTimeout(() => {
            if (!hasInteracted && tooltip) tooltip.style.opacity = "1";
        }, 3000);

        // CLEANUP
        heroCleanup = () => {
            trigger.removeEventListener("mouseenter", startPresentation);
            trigger.removeEventListener("mouseleave", stopPresentation);
            trigger.removeEventListener("touchstart", handleTriggerTouch);
            window.removeEventListener("touchstart", handleGlobalTouch);
            exitIO.disconnect();
            columnTimers.forEach((call) => call.kill());
            columnTimers.length = 0;
            audio.pause();
            audio.currentTime = 0;
            tl.kill();
        };
    }

    document.addEventListener("astro:page-load", initHero);
</script>

<style>
    /* Hide trigger when mobile menu is active */
    :global(body.mobile-menu-active) #hero-magic-trigger {
        opacity: 0 !important;
        visibility: hidden;
    }
</style>
