---
interface VideoItem {
    src: string;
    username: string;
    handle: string;
    caption: string;
    likes: number;
    comments: number;
}

interface Props {
    t: {
        items: VideoItem[];
    };
}

const { t } = Astro.props;
---

<section id="videos" class="relative bg-dark overflow-hidden">
    <!-- ═══ DESKTOP: 3-column triptych ═══ -->
    <div class="hidden md:grid grid-cols-3 h-screen w-full">
        {
            t.items.map((video, i) => (
                <div class="video-cell relative overflow-hidden" data-index={i}>
                    <video
                        class="video-player w-full h-full object-cover"
                        src={video.src}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                    />

                    <!-- Mute/Unmute Icon — bottom-left -->
                    <div class="video-sound-icon absolute bottom-4 left-4 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-dark/50 backdrop-blur-sm border border-white/10 text-light/60 pointer-events-none transition-colors duration-300">
                        <!-- Muted icon (default) -->
                        <svg
                            class="icon-muted w-4 h-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M11 5 6 9H2v6h4l5 4V5z" />
                            <line x1="23" y1="9" x2="17" y2="15" />
                            <line x1="17" y1="9" x2="23" y2="15" />
                        </svg>
                        <!-- Unmuted icon (hidden by default) -->
                        <svg
                            class="icon-unmuted w-4 h-4 hidden"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                            <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
                            <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                        </svg>
                    </div>
                </div>
            ))
        }
    </div>

    <!-- ═══ MOBILE: Observer-driven Reels (NO scroll dependency) ═══ -->
    <div
        id="reels-section"
        class="md:hidden relative h-screen w-full overflow-hidden"
    >
        <div id="reels-track" class="relative w-full h-full">
            {
                t.items.map((video, i) => (
                    <div
                        class="video-reel absolute inset-0 w-full h-full"
                        style={`transform: translateY(${i * 100}%);`}
                        data-index={i}
                    >
                        <video
                            class="video-player absolute inset-0 w-full h-full object-cover"
                            src={video.src}
                            muted
                            loop
                            playsinline
                            preload="metadata"
                        />

                        <!-- Dark gradient overlay -->
                        <div class="absolute inset-0 bg-gradient-to-t from-dark/80 via-transparent to-dark/30 pointer-events-none" />

                        <!-- Social UI (TikTok style) -->
                        <div class="absolute right-3 bottom-28 z-10 flex flex-col items-center gap-5">
                            <div class="relative mb-2">
                                <div class="w-11 h-11 rounded-full border-2 border-purple-light overflow-hidden bg-dark-gray">
                                    <img
                                        src="/images/hero_foreground.png"
                                        alt="Fernando"
                                        class="w-full h-full object-cover"
                                        loading="lazy"
                                    />
                                </div>
                                <div class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-5 h-5 bg-purple-light rounded-full flex items-center justify-center">
                                    <svg class="w-3 h-3 text-dark" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 5v14m-7-7h14" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                                    </svg>
                                </div>
                            </div>

                            <button class="reel-action flex flex-col items-center gap-1" data-action="like">
                                <div class="w-10 h-10 flex items-center justify-center">
                                    <svg class="w-7 h-7 text-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                    </svg>
                                </div>
                                <span class="text-light text-[11px] font-body font-semibold">{video.likes}</span>
                            </button>

                            <button class="reel-action flex flex-col items-center gap-1" data-action="comment">
                                <div class="w-10 h-10 flex items-center justify-center">
                                    <svg class="w-7 h-7 text-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                    </svg>
                                </div>
                                <span class="text-light text-[11px] font-body font-semibold">{video.comments}</span>
                            </button>

                            <button class="reel-action flex flex-col items-center gap-1" data-action="share">
                                <div class="w-10 h-10 flex items-center justify-center">
                                    <svg class="w-7 h-7 text-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" /><polyline points="16 6 12 2 8 6" /><line x1="12" y1="2" x2="12" y2="15" />
                                    </svg>
                                </div>
                                <span class="text-light text-[11px] font-body font-semibold">Compartir</span>
                            </button>

                            <button class="reel-action flex flex-col items-center gap-1" data-action="save">
                                <div class="w-10 h-10 flex items-center justify-center">
                                    <svg class="w-7 h-7 text-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                                    </svg>
                                </div>
                                <span class="text-light text-[11px] font-body font-semibold">Guardar</span>
                            </button>

                            <button class="reel-sound-toggle flex flex-col items-center gap-1">
                                <div class="w-10 h-10 flex items-center justify-center rounded-full bg-dark/40 backdrop-blur-sm border border-white/10">
                                    <svg class="icon-muted w-5 h-5 text-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 5 6 9H2v6h4l5 4V5z" /><line x1="23" y1="9" x2="17" y2="15" /><line x1="17" y1="9" x2="23" y2="15" />
                                    </svg>
                                    <svg class="icon-unmuted w-5 h-5 text-light hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                                    </svg>
                                </div>
                            </button>
                        </div>

                        <div class="absolute bottom-14 left-4 right-16 z-10">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-light font-body font-bold text-sm">{video.username}</span>
                                <span class="text-light/50 text-xs">·</span>
                                <span class="text-light/60 text-xs">Seguir</span>
                            </div>
                            <p class="text-light/90 text-sm font-body leading-relaxed">{video.caption}</p>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Slide indicator dots -->
        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 z-20">
            {t.items.map((_, i) => (
                <div
                    class="reel-dot w-2 h-2 rounded-full transition-all duration-300"
                    style={i === 0 ? "background: #9582D9; transform: scale(1.3);" : "background: rgba(255,255,255,0.3);"}
                    data-dot={i}
                />
            ))}
        </div>
    </div>
</section>

<script>
    import { gsap, ScrollTrigger, Observer } from "../../lib/gsap-init";

    function initVideoTriptych() {
        // ═══ Preload Logic (Eager idle buffering) ═══
        function preloadVideos() {
            const allVideos = document.querySelectorAll<HTMLVideoElement>("#videos .video-player");
            allVideos.forEach((video) => {
                if (video.readyState < 2) {
                    video.load();
                }
            });
        }
        if ("requestIdleCallback" in window) {
            (window as any).requestIdleCallback(preloadVideos, { timeout: 3000 });
        } else {
            setTimeout(preloadVideos, 2000);
        }

        // ════════════════════════════════════════════════════════════════
        // ═══ DESKTOP: Hover Logic + Observer ═══
        // ════════════════════════════════════════════════════════════════
        const desktopCells = document.querySelectorAll<HTMLElement>(".video-cell");
        
        // Observer for play/pause (desktop only)
        const desktopObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    const video = entry.target.querySelector("video");
                    if (!video) return;
                    if (entry.isIntersecting) {
                        video.play().catch(() => {});
                    } else {
                        video.pause();
                    }
                });
            },
            { threshold: 0.2 }
        );
        desktopCells.forEach((cell) => desktopObserver.observe(cell));

        desktopCells.forEach((cell) => {
            const video = cell.querySelector<HTMLVideoElement>(".video-player");
            const iconMuted = cell.querySelector(".icon-muted");
            const iconUnmuted = cell.querySelector(".icon-unmuted");
            if (!video || !iconMuted || !iconUnmuted) return;

            cell.addEventListener("mouseenter", () => {
                // Mute all others
                document.querySelectorAll<HTMLVideoElement>(".video-player").forEach((v) => { v.muted = true; });
                document.querySelectorAll(".video-sound-icon .icon-muted").forEach((el) => el.classList.remove("hidden"));
                document.querySelectorAll(".video-sound-icon .icon-unmuted").forEach((el) => el.classList.add("hidden"));

                // Unmute this one
                video.muted = false;
                iconMuted.classList.add("hidden");
                iconUnmuted.classList.remove("hidden");

                gsap.to(cell.querySelector(".video-sound-icon"), {
                    borderColor: "rgba(149, 130, 217, 0.6)",
                    color: "rgba(149, 130, 217, 1)",
                    duration: 0.3,
                });
            });

            cell.addEventListener("mouseleave", () => {
                video.muted = true;
                iconMuted.classList.remove("hidden");
                iconUnmuted.classList.add("hidden");
                gsap.to(cell.querySelector(".video-sound-icon"), {
                    borderColor: "rgba(255, 255, 255, 0.1)",
                    color: "rgba(255, 255, 255, 0.6)",
                    duration: 0.3,
                });
            });
        });

        // ════════════════════════════════════════════════════════════════
        // ═══ MOBILE: Observer-Driven Reels (gesture-based, no scroll) ═══
        // ════════════════════════════════════════════════════════════════
        const reelsSection = document.getElementById("reels-section");
        const track = document.getElementById("reels-track");
        const reels = document.querySelectorAll<HTMLElement>(".video-reel");

        if (reelsSection && track && reels.length > 0) {
            const totalSlides = reels.length;
            let currentSlide = 0;
            let isAnimating = false;

            // ── Helper: Go to a specific slide ──
            function goToSlide(index: number) {
                // Clamp index to valid range
                if (index < 0 || index >= totalSlides) return;
                if (index === currentSlide) return;
                if (isAnimating) return;

                isAnimating = true;
                currentSlide = index;

                // Animate the track to show the target slide
                gsap.to(track, {
                    y: -currentSlide * window.innerHeight,
                    duration: 0.5,
                    ease: "power2.inOut",
                    overwrite: true,
                    onComplete: () => {
                        isAnimating = false;
                    },
                });

                // Play/pause videos
                reels.forEach((reel, i) => {
                    const video = reel.querySelector("video");
                    if (!video) return;
                    if (i === currentSlide) {
                        video.play().catch(() => {});
                    } else {
                        video.pause();
                        video.muted = true;
                        reel.querySelector(".icon-muted")?.classList.remove("hidden");
                        reel.querySelector(".icon-unmuted")?.classList.add("hidden");
                    }
                });

                // Update dot indicators
                document.querySelectorAll(".reel-dot").forEach((dot, i) => {
                    if (i === currentSlide) {
                        (dot as HTMLElement).style.background = "#9582D9";
                        (dot as HTMLElement).style.transform = "scale(1.3)";
                    } else {
                        (dot as HTMLElement).style.background = "rgba(255,255,255,0.3)";
                        (dot as HTMLElement).style.transform = "scale(1)";
                    }
                });
            }

            // ── State ──
            let gsapObserver: Observer | null = null;
            let sectionActive = false;
            let isExiting = false;
            let gestureDebounce = false;

            function resetState(slideIndex: number) {
                currentSlide = slideIndex;
                isAnimating = false;
                gsap.killTweensOf(track);
                gsap.set(track, { y: -currentSlide * window.innerHeight });
                document.querySelectorAll(".reel-dot").forEach((dot, i) => {
                    (dot as HTMLElement).style.background = i === currentSlide ? "#9582D9" : "rgba(255,255,255,0.3)";
                    (dot as HTMLElement).style.transform = i === currentSlide ? "scale(1.3)" : "scale(1)";
                });
            }

            // ── ENTRY: Magnetize when ≥50% visible ──
            const entryIO = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting || sectionActive || isExiting) return;
                        sectionActive = true;

                        // Detect scroll direction: if section top is above viewport center,
                        // the user scrolled DOWN into it (show first slide).
                        // If section top is below viewport center, user scrolled UP into it
                        // (show last slide).
                        const rect = entry.boundingClientRect;
                        const enteringFromBelow = rect.top > window.innerHeight * 0.3;
                        if (enteringFromBelow) {
                            resetState(totalSlides - 1);
                        } else {
                            resetState(0);
                        }

                        // Snap into position
                        reelsSection!.scrollIntoView({ behavior: "smooth", block: "start" });

                        // Activate Observer after snap settles
                        setTimeout(() => {
                            if (sectionActive && !gsapObserver) {
                                createGsapObserver();
                            }
                            const v = reels[currentSlide]?.querySelector("video");
                            if (v) v.play().catch(() => {});
                        }, 500);
                    });
                },
                { threshold: 0.5 }
            );
            entryIO.observe(reelsSection);

            // ── GESTURE OBSERVER ──
            function createGsapObserver() {
                if (gsapObserver) return; // Prevent duplicates
                gsapObserver = Observer.create({
                    target: reelsSection!,
                    type: "touch,wheel",
                    tolerance: 15,
                    preventDefault: true,
                    dragMinimum: 8,
                    onUp: () => {
                        if (isAnimating || isExiting || gestureDebounce) return;
                        lockGesture();

                        if (currentSlide >= totalSlides - 1) {
                            exitSection("down");
                            return;
                        }
                        goToSlide(currentSlide + 1);
                    },
                    onDown: () => {
                        if (isAnimating || isExiting || gestureDebounce) return;
                        lockGesture();

                        if (currentSlide <= 0) {
                            exitSection("up");
                            return;
                        }
                        goToSlide(currentSlide - 1);
                    },
                });
            }

            function lockGesture() {
                gestureDebounce = true;
                setTimeout(() => { gestureDebounce = false; }, 300);
            }

            // ── EXIT: Navigate to #shows (up) or #jury (down) ──
            function exitSection(direction: "up" | "down") {
                if (isExiting) return;
                isExiting = true;
                sectionActive = false;

                destroyGsapObserver();
                entryIO.disconnect();

                const targetId = direction === "down" ? "jury" : "shows";
                const target = document.getElementById(targetId);
                if (target) {
                    target.scrollIntoView({ behavior: "smooth", block: "start" });
                }

                // Re-arm only after section fully leaves viewport
                const leaveIO = new IntersectionObserver(
                    (entries) => {
                        if (!entries[0]?.isIntersecting) {
                            leaveIO.disconnect();
                            isExiting = false;
                            gestureDebounce = false;
                            // Reset for next entry
                            resetState(direction === "down" ? 0 : totalSlides - 1);
                            entryIO.observe(reelsSection!);
                        }
                    },
                    { threshold: 0 }
                );
                leaveIO.observe(reelsSection!);
            }

            function destroyGsapObserver() {
                gsap.killTweensOf(track);
                isAnimating = false;
                if (gsapObserver) {
                    gsapObserver.kill();
                    gsapObserver = null;
                }
            }

            // ── Tap-to-mute ──
            reels.forEach((reel) => {
                const video = reel.querySelector<HTMLVideoElement>("video");
                const iconMuted = reel.querySelector(".icon-muted");
                const iconUnmuted = reel.querySelector(".icon-unmuted");
                if (!video || !iconMuted || !iconUnmuted) return;

                reel.addEventListener("click", (e) => {
                    if ((e.target as HTMLElement).closest(".reel-action, .reel-sound-toggle")) return;
                    video.muted = !video.muted;
                    iconMuted.classList.toggle("hidden", !video.muted);
                    iconUnmuted.classList.toggle("hidden", video.muted);
                });
            });

            // Play the first video on init
            const firstVideo = reels[0]?.querySelector("video");
            if (firstVideo) firstVideo.play().catch(() => {});

            // Cleanup for Astro page transitions
            document.addEventListener("astro:before-preparation", () => {
                destroyGsapObserver();
                entryIO.disconnect();
            }, { once: true });
        }

        // Like button animation
        document.querySelectorAll('.reel-action[data-action="like"]').forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const svg = btn.querySelector("svg");
                if (!svg) return;
                const isLiked = svg.getAttribute("fill") === "currentColor";
                svg.setAttribute("fill", isLiked ? "none" : "currentColor");
                svg.classList.toggle("text-red-500", !isLiked);
                svg.classList.toggle("text-light", isLiked);
                gsap.fromTo(svg, { scale: 1.4 }, { scale: 1, duration: 0.4, ease: "elastic.out(1, 0.3)" });
            });
        });
    }

    document.addEventListener("astro:page-load", initVideoTriptych);
</script>

<style>
    /* Desktop Hover Effects */
    @media (hover: hover) {
        .video-cell .video-player {
            filter: grayscale(1);
            transition: transform 1.5s cubic-bezier(0.22, 1, 0.36, 1), filter 0.8s ease;
        }
        .video-cell:hover .video-player {
            transform: scale(1.05);
            filter: grayscale(0);
        }
    }

    #reels-track {
        will-change: transform;
    }

    /* Prevent overscroll bounce on the reels section (iOS) */
    #reels-section {
        overscroll-behavior: none;
        touch-action: none;
    }
</style>

